{
	"name": "@standard/sanity-kit",
	"version": "0.0.0",
	"private": true,
	"description": "Runtime-explicit Sanity primitives for Standard Design applications",
	"license": "UNLICENSED",
	"type": "module",
	"sideEffects": false,
	"packageManager": "pnpm@11.26.0",
	"engines": {
		"node": ">=24.0.0"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"import": "./dist/core/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"format:check": "prettier --check --cache --cache-location ./.prettier-cache .",
		"format:fix": "prettier --write --cache --cache-location ./.prettier-cache .",
		"lint": "eslint --cache --cache-location ./.eslintcache .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.0.0",
		"@vitest/coverage-v8": "^5.0.1",
		"eslint": "10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.6.2",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.47.0",
		"vitest": "^5.0.1"
	}
}
