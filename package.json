{
	"name": "@standard/sanity-kit",
	"version": "0.0.0",
	"private": true,
	"description": "Runtime-explicit Sanity primitives for Standard Design applications",
	"license": "UNLICENSED",
	"type": "module",
	"sideEffects": false,
	"packageManager": "pnpm@11.26.0",
	"engines": {
		"node": ">=24.0.0"
	},
	"files": [
		"dist",
		"docs/sitemaps.md",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"import": "./dist/core/index.js"
		},
		"./image": {
			"types": "./dist/image/index.d.ts",
			"import": "./dist/image/index.js"
		},
		"./image/react": {
			"types": "./dist/image/react/index.d.ts",
			"import": "./dist/image/react/index.js"
		},
		"./link": {
			"types": "./dist/link/index.d.ts",
			"import": "./dist/link/index.js"
		},
		"./sitemap": {
			"types": "./dist/sitemap/index.d.ts",
			"import": "./dist/sitemap/index.js"
		},
		"./react-router": {
			"types": "./dist/react-router/index.d.ts",
			"import": "./dist/react-router/index.js"
		},
		"./react-router/visual-editing": {
			"types": "./dist/react-router/visual-editing/index.d.ts",
			"import": "./dist/react-router/visual-editing/index.js"
		},
		"./react-router/server": {
			"types": "./dist/react-router/server/index.d.ts",
			"import": "./dist/react-router/server/index.js"
		},
		"./validation/zod": {
			"types": "./dist/validation/zod/index.d.ts",
			"import": "./dist/validation/zod/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"format:check": "prettier --check --cache --cache-location ./.prettier-cache .",
		"format:fix": "prettier --write --cache --cache-location ./.prettier-cache .",
		"lint": "eslint --cache --cache-location ./.eslintcache .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
	},
	"peerDependencies": {
		"@sanity/client": "^7.27.0 || ^8.6.0",
		"@sanity/image-url": "^2.1.1",
		"@sanity/preview-url-secret": "^3.0.0 || ^4.1.0",
		"@sanity/visual-editing": "^6.1.2",
		"groq": "^5.1.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router": "^8.4.0",
		"zod": "^4.6.5"
	},
	"peerDependenciesMeta": {
		"@sanity/image-url": {
			"optional": true
		},
		"@sanity/preview-url-secret": {
			"optional": true
		},
		"@sanity/visual-editing": {
			"optional": true
		},
		"groq": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"react-router": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sanity/client": "^8.6.0",
		"@sanity/image-url": "^2.1.1",
		"@sanity/preview-url-secret": "^4.1.0",
		"@sanity/visual-editing": "^6.1.2",
		"@types/node": "^24.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^5.0.1",
		"eslint": "10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"groq": "^5.1.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.6.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^8.4.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.47.0",
		"vitest": "^5.0.1",
		"zod": "^4.6.5"
	}
}
